#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int i;

    printf("Parent Process: PID = %d\n", getpid());

    for (i = 1; i <= 3; i++) {
        pid_t pid = fork();

        if (pid == 0) {
            printf("Child %d: PID = %d, PPID = %d\n",
                   i, getpid(), getppid());
            return 0;
        }

        wait(NULL);

        printf("Child %d completed\n", i);
    }

    return 0;
}
