#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t semaphore;

void *process(void *arg)
{
    int id = *(int *)arg;

    sem_wait(&semaphore);

    printf("Process %d entered critical section.\n", id);
    printf("Process %d is executing.\n", id);
    printf("Process %d exited critical section.\n", id);

    sem_post(&semaphore);

    return NULL;
}

int main()
{
    pthread_t t1, t2;
    int p1 = 1, p2 = 2;

    sem_init(&semaphore, 0, 1);

    pthread_create(&t1, NULL, process, &p1);
    pthread_create(&t2, NULL, process, &p2);

    pthread_join(t1, NULL);
    pthread_join(t2, NULL);

    sem_destroy(&semaphore);

    return 0;
}
Output
Process 1 entered critical section.
Process 1 is executing.
Process 1 exited critical section.
Process 2 entered critical section.
Process 2 is executing.
Process 2 exited critical section.
