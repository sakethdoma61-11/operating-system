#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main() {
    int choice, fd;
    char name[50], record[100];
    int roll;

    while (1) {
        printf("\n1. Create File");
        printf("\n2. Add Student");
        printf("\n3. View Records");
        printf("\n4. Append Record");
        printf("\n5. Delete File");
        printf("\n6. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            fd = open("students.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
            if (fd >= 0) {
                printf("File created successfully.\n");
                close(fd);
            }
        }

        else if (choice == 2 || choice == 4) {
            fd = open("students.txt", O_CREAT | O_WRONLY | O_APPEND, 0644);

            printf("Enter Roll No: ");
            scanf("%d", &roll);

            printf("Enter Name: ");
            scanf("%s", name);

            sprintf(record, "Roll: %d, Name: %s\n", roll, name);
            write(fd, record, strlen(record));
            close(fd);

            printf("Record added.\n");
        }

        else if (choice == 3) {
            char buffer[200];
            int n;

            fd = open("students.txt", O_RDONLY);

            while ((n = read(fd, buffer, sizeof(buffer) - 1)) > 0) {
                buffer[n] = '\0';
                printf("%s", buffer);
            }

            close(fd);
        }

        else if (choice == 5) {
            unlink("students.txt");
            printf("File deleted.\n");
        }

        else if (choice == 6)
            break;

        else
            printf("Invalid choice.\n");
    }

    return 0;
}
