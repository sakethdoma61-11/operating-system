#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char buffer[100];

    fd = open("file.txt", O_CREAT | O_RDWR, 0644);

    if (fd < 0)
    {
        perror("File opening failed");
        return 1;
    }

    printf("File created and opened successfully.\n");

    write(fd, "File Management Operations", 26);

    lseek(fd, 0, SEEK_SET);

    read(fd, buffer, 26);
    buffer[26] = '\0';

    printf("File Content: %s\n", buffer);

    close(fd);

    printf("File closed successfully.\n");

    return 0;
}
Output
File created and opened successfully.
File Content: File Management Operations
File closed successfully.
