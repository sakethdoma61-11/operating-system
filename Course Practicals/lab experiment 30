#include <stdio.h>
#include <unistd.h>
#include <string.h>
#include <sys/wait.h>

int main() {

    int parent_to_child[2];
    int child_to_parent[2];

    pipe(parent_to_child);
    pipe(child_to_parent);

    pid_t pid = fork();

    if (pid == 0) {

        char message[100];

        close(parent_to_child[1]);
        close(child_to_parent[0]);

        read(parent_to_child[0], message, sizeof(message));
        printf("Child received: %s\n", message);

        strcpy(message, "Hello Parent!");
        write(child_to_parent[1],
              message, strlen(message) + 1);

        close(parent_to_child[0]);
        close(child_to_parent[1]);
    }

    else {

        char message[100];

        close(parent_to_child[0]);
        close(child_to_parent[1]);

        strcpy(message, "Hello Child!");

        write(parent_to_child[1],
              message, strlen(message) + 1);

        read(child_to_parent[0],
             message, sizeof(message));

        printf("Parent received: %s\n", message);

        close(parent_to_child[1]);
        close(child_to_parent[0]);

        wait(NULL);
    }

    return 0;
}
