#include <stdio.h>

int main() {
    FILE *fp;
    char data[100];

    fp = fopen("sample.txt", "w");

    if(fp == NULL) {
        printf("File creation failed\n");
        return 1;
    }

    fprintf(fp, "Hello, File Management!");
    fclose(fp);

    fp = fopen("sample.txt", "r");

    if(fp == NULL) {
        printf("File opening failed\n");
        return 1;
    }

    fgets(data, sizeof(data), fp);
    printf("File content: %s\n", data);

    fclose(fp);

    fp = fopen("sample.txt", "a");
    fprintf(fp, "\nNew data added.");
    fclose(fp);

    printf("File operations completed successfully.\n");

    return 0;
}
File content: Hello, File Management!
File operations completed successfully.
