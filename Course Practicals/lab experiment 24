#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd;
    char data[] = "Hello UNIX";
    char buffer[50];

    fd = open("test.txt", O_CREAT | O_RDWR, 0644);

    if(fd < 0) {
        printf("File open failed\n");
        return 1;
    }

    write(fd, data, sizeof(data));

    lseek(fd, 0, SEEK_SET);

    read(fd, buffer, sizeof(data));
    buffer[sizeof(data)] = '\0';

    printf("File content: %s\n", buffer);

    close(fd);

    return 0;
}
