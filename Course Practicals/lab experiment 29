#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {

    int jobs = 3;

    printf("Printer Queue Started\n");

    for (int i = 1; i <= jobs; i++) {

        pid_t pid = fork();

        if (pid == 0) {

            printf("Print Job %d started. PID = %d\n",
                   i, getpid());

            sleep(2);

            printf("Print Job %d completed.\n", i);

            return 0;
        }

        wait(NULL);
    }

    printf("All print jobs completed.\n");

    return 0;
}
