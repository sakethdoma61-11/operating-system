4. Translation Lookaside Buffer (TLB) Simulation
#include <stdio.h>

int main() {
    float hitRatio;
    float memTime = 100;
    float tlbTime = 20;
    float withoutTLB, withTLB;

    // Read TLB hit ratio
    printf("Enter TLB Hit Ratio (0-1): ");
    scanf("%f", &hitRatio);

    // Memory access time without TLB
    withoutTLB = 2 * memTime;

    // Memory access time with TLB
    withTLB = hitRatio * (tlbTime + memTime) +
              (1 - hitRatio) * (tlbTime + 2 * memTime);

    // Display results
    printf("Without TLB = %.2f ns\n", withoutTLB);
    printf("With TLB = %.2f ns\n", withTLB);

    return 0;
}
OUTPUT:
Enter TLB Hit Ratio (0-1): 0.8
Without TLB = 200.00 ns
With TLB = 140.00 ns


5. Memory Protection using Base and Limit Registers
#include <stdio.h>

int main() {
    int limit, logical;

    // Read limit register value
    printf("Enter Limit Register: ");
    scanf("%d", &limit);

    // Read logical address
    printf("Enter Logical Address: ");
    scanf("%d", &logical);

    // Check whether access is allowed
    if (logical >= 0 && logical < limit) {
        printf("Access Allowed\n");
    } else {
        printf("Access Denied\n");
    }

    return 0;
}
OUTPUT:
Enter Limit Register: 500
Enter Logical Address: 250
Access Allowed
