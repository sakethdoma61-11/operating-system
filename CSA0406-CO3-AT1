1. Logical Address to Physical Address using Base and Limit Registers
#include <stdio.h>

int main() {
    int base, limit, logical;

    // Read base register value
    printf("Enter Base Register: ");
    scanf("%d", &base);

    // Read limit register value
    printf("Enter Limit Register: ");
    scanf("%d", &limit);

    // Read logical address
    printf("Enter Logical Address: ");
    scanf("%d", &logical);

    // Check whether logical address is valid
    if (logical < limit) {
        printf("Valid Address\n");

        // Calculate physical address
        printf("Physical Address = %d\n", base + logical);
    } else {
        printf("Invalid Address\n");
    }

    return 0;
}
Output:
Enter Base Register: 1000
Enter Limit Register: 500
Enter Logical Address: 200
Valid Address
Physical Address = 1200


2. Paging Memory Management
#include <stdio.h>

int main() {
    int pageTable[10], n, page, offset, frame;

    // Read number of pages
    printf("Enter number of pages: ");
    scanf("%d", &n);

    // Read frame numbers for each page
    printf("Enter frame numbers:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &pageTable[i]);
    }

    // Read page number
    printf("Enter Page Number: ");
    scanf("%d", &page);

    // Read offset
    printf("Enter Offset: ");
    scanf("%d", &offset);

    // Find frame number
    frame = pageTable[page];

    // Calculate physical address
    printf("Physical Address = %d\n", frame * 100 + offset);

    return 0;
}
OUTPUT:
Enter number of pages: 4
Enter frame numbers:
5
8
2
6
Enter Page Number: 2
Enter Offset: 35
Physical Address = 235


