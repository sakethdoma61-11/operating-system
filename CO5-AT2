Q5. CPU and Memory Resource Limiting
ANSWER:
BEGIN
INPUT application_list
FOR each app IN application_list DO
    CREATE cgroup FOR app
    SET CPU limit FOR app
    SET memory limit FOR app
    ASSIGN app_process TO cgroup
    MONITOR CPU_USAGE(app)
    MONITOR MEMORY_USAGE(app)
    IF CPU_USAGE(app) > CPU limit THEN
        THROTTLE CPU usage
    ENDIF
    IF MEMORY_USAGE(app) > memory limit THEN
        LIMIT memory usage
    ENDIF
END FOR
PRINT "CPU and memory limits applied successfully"
END
