PROGRAM:

#include <stdio.h>
#include <stdlib.h>

void fcfs(int a[], int n, int head) {
    int i, seek = 0, cur = head;

    printf("\nFCFS Seek Sequence: %d ", head);

    for (i = 0; i < n; i++) {
        seek += abs(cur - a[i]);
        cur = a[i];
        printf("-> %d ", cur);
    }

    printf("\nTotal Seek Time = %d\n", seek);
}

void sstf(int a[], int n, int head) {
    int done[100] = {0};
    int i, j, seek = 0;
    int cur = head, min, pos;

    printf("\nSSTF Seek Sequence: %d ", head);

    for (i = 0; i < n; i++) {
        min = 99999;
        pos = -1;

        for (j = 0; j < n; j++) {
            if (!done[j] && abs(cur - a[j]) < min) {
                min = abs(cur - a[j]);
                pos = j;
            }
        }

        done[pos] = 1;
        seek += min;
        cur = a[pos];

        printf("-> %d ", cur);
    }

    printf("\nTotal Seek Time = %d\n", seek);
}

void scan(int a[], int n, int head, int disk) {
    int i, j, seek = 0, cur = head;
    int temp;

    printf("\nSCAN Seek Sequence: %d ", head);

    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    for (i = 0; i < n; i++) {
        if (a[i] >= head) {
            seek += abs(cur - a[i]);
            cur = a[i];
            printf("-> %d ", cur);
        }
    }

    seek += abs(cur - (disk - 1));
    cur = disk - 1;

    printf("-> %d ", cur);

    for (i = n - 1; i >= 0; i--) {
        if (a[i] < head) {
            seek += abs(cur - a[i]);
            cur = a[i];
            printf("-> %d ", cur);
        }
    }

    printf("\nTotal Seek Time = %d\n", seek);
}

int main() {
    int a[100], b[100];
    int n, head, disk, i;

    printf("Enter disk size: ");
    scanf("%d", &disk);

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        b[i] = a[i];
    }

    printf("Enter initial head position: ");
    scanf("%d", &head);

    fcfs(a, n, head);
    sstf(a, n, head);
    scan(b, n, head, disk);

    return 0;
}


