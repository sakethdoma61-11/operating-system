QUESTION 1
FILE ALLOCATION METHODS
CONTIGUOUS, LINKED AND INDEXED
============================================================

PROGRAM:

#include <stdio.h>

int main() {
    int disk[100] = {0};
    int n, f, method;
    int i, j, count = 0;

    printf("Enter total disk blocks: ");
    scanf("%d", &n);

    printf("Enter file size: ");
    scanf("%d", &f);

    printf("Enter allocation method (1-Contiguous, 2-Linked, 3-Indexed): ");
    scanf("%d", &method);

    if (f > n) {
        printf("Allocation not possible.\n");
        return 0;
    }

    if (method == 1) {
        for (i = 0; i <= n - f; i++) {
            for (j = i; j < i + f; j++) {
                if (disk[j] == 1)
                    break;
            }

            if (j == i + f) {
                printf("Allocated blocks: ");
                for (j = i; j < i + f; j++) {
                    disk[j] = 1;
                    printf("%d ", j);
                }
                printf("\n");
                return 0;
            }
        }

        printf("Contiguous allocation failed: insufficient continuous space.\n");
    }

    else if (method == 2) {
        printf("Allocated blocks: ");

        for (i = 0; i < n && count < f; i++) {
            if (disk[i] == 0) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }

        printf("\n");
    }

    else if (method == 3) {
        disk[0] = 1;

        printf("Index block: 0\n");
        printf("Allocated blocks: ");

        for (i = 1; i < n && count < f; i++) {
            if (disk[i] == 0) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }

        printf("\n");
    }

    else {
        printf("Invalid allocation method.\n");
    }

    return 0;
}


