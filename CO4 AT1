            cscan += abs(cur - left[i]);
            cur = left[i];
            printf("-> %d ", cur);
        }
    }

    printf("\nC-SCAN Total Head Movement = %d\n", cscan);

    printf("\nLOOK Seek Sequence: %d ", head);

    cur = head;

    if (direction == 1) {

        for (i = 0; i < r; i++) {
            look += abs(cur - right[i]);
            cur = right[i];
            printf("-> %d ", cur);
        }

        for (i = l - 1; i >= 0; i--) {
            look += abs(cur - left[i]);
            cur = left[i];
            printf("-> %d ", cur);
