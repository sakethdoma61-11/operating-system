PROGRAM:

#include <stdio.h>
#include <stdlib.h>

int main() {
    int disk[100] = {0};
    int blocks[100];
    int done[100] = {0};

    int n, f, method, schedule, head;
    int i, j, count = 0;
    int cur, seek = 0;
    int min, pos;

    printf("Enter total disk blocks: ");
    scanf("%d", &n);

    printf("Enter file size: ");
    scanf("%d", &f);

    printf("Allocation method (1=Contiguous, 2=Indexed): ");
    scanf("%d", &method);

    printf("Scheduling method (1=FCFS, 2=SSTF): ");
    scanf("%d", &schedule);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    /* CONTIGUOUS ALLOCATION */

    if (method == 1) {

        for (i = 0; i <= n - f; i++) {

            for (j = i; j < i + f; j++) {
                if (disk[j] == 1)
                    break;
            }

            if (j == i + f) {

                for (j = i; j < i + f; j++) {
                    disk[j] = 1;
                    blocks[count++] = j;
                }

                break;
            }
        }
    }

    /* INDEXED ALLOCATION */

    else if (method == 2) {

        disk[0] = 1;

        for (i = 1; i < n && count < f; i++) {

            if (disk[i] == 0) {
                disk[i] = 1;
                blocks[count++] = i;
            }
        }
    }

    else {
        printf("Invalid allocation method.\n");
        return 0;
    }

    if (count < f) {
        printf("Allocation failed.\n");
        return 0;
    }

    printf("\nAllocated blocks: ");

    for (i = 0; i < f; i++)
        printf("%d ", blocks[i]);

    printf("\n");

    cur = head;

    printf("Seek Sequence: %d ", head);

    /* FCFS */

    if (schedule == 1) {

        for (i = 0; i < f; i++) {

            seek += abs(cur - blocks[i]);
            cur = blocks[i];

            printf("-> %d ", cur);
        }
    }

    /* SSTF */

    else if (schedule == 2) {

        for (i = 0; i < f; i++) {

            min = 99999;
            pos = -1;

            for (j = 0; j < f; j++) {

                if (!done[j] &&
                    abs(cur - blocks[j]) < min) {

                    min = abs(cur - blocks[j]);
                    pos = j;
                }
            }

            done[pos] = 1;

            seek += min;
            cur = blocks[pos];

            printf("-> %d ", cur);
        }
    }

    else {
        printf("\nInvalid scheduling method.\n");
        return 0;
    }

    printf("\nTotal Seek Time = %d\n", seek);

    if (method == 1)
        printf("Allocation Method = Contiguous\n");
    else
        printf("Allocation Method = Indexed\n");

    if (schedule == 1)
        printf("Scheduling Method = FCFS\n");
    else
        printf("Scheduling Method = SSTF\n");

    return 0;
}


