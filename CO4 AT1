PROGRAM:

#include <stdio.h>

int main() {
    int bitmap[100];
    int n, req, d, block;
    int i, count = 0;

    printf("Enter number of disk blocks: ");
    scanf("%d", &n);

    printf("Enter bitmap (0=free, 1=allocated):\n");

    for (i = 0; i < n; i++)
        scanf("%d", &bitmap[i]);

    printf("Enter number of blocks required: ");
    scanf("%d", &req);

    for (i = 0; i < n && count < req; i++) {
        if (bitmap[i] == 0) {
            bitmap[i] = 1;
            count++;
        }
    }

    if (count < req) {
        printf("Allocation failed: insufficient free blocks.\n");
        return 0;
    }

    printf("Bitmap after allocation:\n");

    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    printf("\n");

    printf("Enter number of blocks to deallocate: ");
    scanf("%d", &d);

    printf("Enter block numbers to deallocate:\n");

    for (i = 0; i < d; i++) {
        scanf("%d", &block);

        if (block >= 0 && block < n)
            bitmap[block] = 0;
    }

    printf("Bitmap after deallocation:\n");

    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    printf("\n");

    return 0;
}


