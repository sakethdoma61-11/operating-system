    scanf("%d", &direction);

    sort(a, n);

    for (i = 0; i < n; i++) {
        if (a[i] < head)
            left[l++] = a[i];
        else
            right[r++] = a[i];
    }

    printf("\nC-SCAN Seek Sequence: %d ", head);

    cur = head;

    if (direction == 1) {

        for (i = 0; i < r; i++) {
            cscan += abs(cur - right[i]);
            cur = right[i];
            printf("-> %d ", cur);
        }

        cscan += abs(cur - (disk - 1));
        cur = disk - 1;

        printf("-> %d ", cur);

